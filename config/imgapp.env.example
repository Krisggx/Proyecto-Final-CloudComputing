# /etc/imgapp.env - solo valores NO secretos.
# La contrasena de la base se lee de AWS Secrets Manager (DB_SECRET_ARN).
AWS_REGION=us-east-1
BUCKET=nombre-del-bucket
DB_HOST=endpoint-de-rds.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_NAME=imgdb
DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:CUENTA:secret:imgproj-db-XXXXXX
INSTANCE_NAME=app-a
MIN_CONFIDENCE=70
