[Unit]
Description=Aplicacion web de analisis de imagenes (Gunicorn + Flask)
After=network-online.target
Wants=network-online.target

[Service]
User=appuser
Group=appuser
WorkingDirectory=/opt/imgapp
EnvironmentFile=/etc/imgapp.env
ExecStart=/opt/imgapp/venv/bin/gunicorn --workers 3 --timeout 60 --bind 0.0.0.0:5000 --access-logfile - app:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
